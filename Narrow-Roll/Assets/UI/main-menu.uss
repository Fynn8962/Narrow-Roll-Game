:root {
}

.panel {
    background-color: rgba(25, 50, 90, 0.59);
    align-items: center;
    justify-content: center;
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.menu {
    background-color: rgba(255, 255, 255, 0.98);
    width: 437px;
    height: auto;
    align-items: stretch;
    max-height: none;
    padding-top: 5px;
    padding-right: 5px;
    padding-bottom: 5px;
    padding-left: 5px;
    border-top-left-radius: 32px;
    border-top-right-radius: 32px;
    border-bottom-right-radius: 32px;
    border-bottom-left-radius: 32px;
}

.unity-button {
    align-items: stretch;
    justify-content: flex-start;
    flex-grow: 1;
    flex-direction: column;
    border-top-left-radius: 24px;
    border-top-right-radius: 24px;
    border-bottom-right-radius: 24px;
    border-bottom-left-radius: 24px;
    background-color: rgb(71, 133, 231);
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    margin-top: 10px;
    margin-right: 10px;
    margin-bottom: 10px;
    margin-left: 10px;
    text-shadow: 0 0 0 rgb(255, 1, 1);
    -unity-background-image-tint-color: rgb(255, 255, 255);
    max-height: none;
    border-left-color: rgb(25, 50, 90);
    border-right-color: rgb(25, 50, 90);
    border-top-color: rgb(25, 50, 90);
    border-bottom-color: rgb(25, 50, 90);
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-left-width: 3px;
}

.unity-text-element {
    font-size: 42px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    -unity-font-definition: url("project://database/Library/unity%20default%20resources?fileID=10102&guid=0000000000000000e000000000000000&type=0#LegacyRuntime");
    padding-top: 5px;
    padding-right: 5px;
    padding-bottom: 5px;
    padding-left: 5px;
    color: rgb(25, 50, 89);
}

.unity-button:hover {
    background-color: rgb(121, 141, 200);
}
